{
  "name": "@taraksh011/memoryhub",
  "version": "0.4.0",
  "description": "MCP server for persistent memory using Qdrant vector store",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "memoryhub": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "tsc --noEmit",
    "build": "tsup src/index.ts --clean --sourcemap --format esm --external @modelcontextprotocol/sdk --external @qdrant/js-client-rest",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "pnpm build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@qdrant/js-client-rest": "^1.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
